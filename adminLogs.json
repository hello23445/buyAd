{
  "schemaVersion": 2,
  "storageMode": "private-server-required",
  "repositoryNote": "Public schema contract only. Live entries must be stored by a private backend. Never commit real administrator tokens, target IDs, IP addresses, moderation decisions or reasons here.",
  "entrySchema": {
    "id": "uuid",
    "timestamp": "ISO-8601 UTC",
    "adminToken": "string (private administrator token)",
    "adminTelegramId": "string|null (private)",
    "adminName": "string|null",
    "adminNameHidden": "boolean",
    "adminLevel": "number",
    "action": "warning_issued|warnings_removed|warning_removed_automatically|automatic_unlock_and_clear|punishment_issued|punishment_removed|ip_banned|ip_unbanned|ad_reviewed|ad_approved|ad_rejected|user_log_viewed|admin_log_viewed|ip_lookup|menu_opened|ui_action|system_setting_changed|other",
    "targetToken": "string|null (private)",
    "targetTelegramId": "string|null (private)",
    "targetIp": "string|null (private)",
    "reason": "string|null",
    "durationDays": "number|null",
    "adId": "string|null",
    "decision": "approved|rejected|null",
    "details": "object"
  },
  "entries": []
}
